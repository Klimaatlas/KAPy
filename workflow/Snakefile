# KAPy Workflow
#
# This snakemake workflow handles the processing of data for use
# in Klimaatlas-like products. 
#
# The pipeline can be run using
#    > snakemake --cores 1 <target>
#
# A list of available target rules can be obatined using
#   > snakemake -S
#
# Workflow configuration options are set in config.yaml
#


#Setup-----------------------
#Load configuration 
DEFAULT_CONFIG = "./config/config.yaml"  #Defined relative to execution directory
if workflow.overwrite_configfiles:
    configfile_path = workflow.overwrite_configfiles[0]
else:
    configfile_path = DEFAULT_CONFIG
print(f'KAPy configuration file: {configfile_path}')

#Load and validate
import KAPy
import os

config=KAPy.getConfig(configfile_path)
outDirs=config['dirs']

#Generate filename dicts
WORKFLOW=KAPy.getWorkflow(config)

# Wildcard rules -------------------------------------------
# Wildcard rules are generic rules in Snakemake that deal with many files at a time -
# in KAPy we preface all such rules with an underscore "_" and a number indicating
# where in the processing chain their lie.
# The wf dict describes the nodes that are linked in the pipeline that we are
# trying to create, ie file c.nc is generated from files a.nc and b.nc. Here we
# translate that mapping into snakemake by declaring the code required to make
# that transformation. There is generally one "wildcard rule" for each of the
# main processing steps

#Primary variables
#This proved to be a bit tricky to setup, but thanks to ChatGPT for some big hints here
#The rule is based on a dictionary mapping output files to input files, but we also 
#need to keep track of the corresponding inpID, which contains the various configurations
#relevant for that output file. 
rule _01_primaryVar:
    input:
        lambda wc: WORKFLOW['primary_vars'][wc.leaf]["inputs"]
    output:
        os.path.join(outDirs['primaryVariables'],"{leaf}")
    params:
        inpID=lambda wc: WORKFLOW['primary_vars'][wc.leaf]["groupID"]
    run:
        KAPy.buildPrimVar(
            outFile=output,
            inFiles=input,
            picklePrimaryVariables=config['processing']['picklePrimaryVariables'],
            cutoutArgs=config['cutouts'],
            **config['inputs'][params.inpID]
        )                          

# Secondary variables 
# "Secondary variables" are calculated as new variables derived from primary variables.  
# Good examples include FWI, PoteEvap and SPI. 
for thisID, thisRow in WORKFLOW['secondary_vars'].items():
    rule:
        name: f"_02_secondaryVar_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw["input_dict"][wc.dataset +"_"+wc.leaf])
        output: **thisRow['output_rule']
        params: groupID=thisID
        run:
            SV=KAPy.buildDerivedVar(inFiles=dict(input),
                                    **config['secondaryVars'][params.groupID])
            KAPy.write_outputs(SV,dict(output))

# Bias Adjustment 
for thisID, thisRow in WORKFLOW['bias_adj'].items():
    rule:
        name: f"_03_biasAdjustment_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw['input_dict'][wc.leaf])
        output: **thisRow['output_rule']
        params: groupID=thisID
        run:
            KAPy.biasAdjust(outFile=output,
                        histsimFile=input.histsim,
                        refFile=input.ref,
                        tempDir=config['dirs']['tempDir'],
                        **config['biasAdjustment'][params.groupID])

# Tertiary variables 
# "Tertiary variables" are calculated as new variables derived from variables created
# by bias adjustment. Good examples include FWI, PoteEvap and SPI, but based on bias-adjusted
# variables, rather than raw input variables.
for thisID, thisRow in WORKFLOW['tertiary_vars'].items():
    rule:
        name: f"_04_tertiaryVar_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw["input_dict"][wc.dataset +"_"+wc.leaf])
        output: **thisRow['output_rule']
        params: groupID=thisID
        run:
            TV=KAPy.buildDerivedVar(inFiles=dict(input),
                                    **config['tertiaryVars'][params.groupID])
            KAPy.write_outputs(TV,dict(output))

# Indicators 
# Create a loop over the indicators that defines the singular and plural rules
# as well as the combined run
for thisID, thisRow in WORKFLOW['indicators'].items():
    rule:
        name: f"_05_indicator_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw["input_dict"][wc.dataset +"_"+wc.leaf])
        output: **thisRow['output_rule']
        params: groupID=thisID
        run:
            KAPy.calculateIndicators(outFile=output,
                                    inFile=input,
                                    seasonsTable=config['seasons'],
                                    periodsTable=config['periods'],
                                    **config['indicators'][params.groupID])

# Regridding  
# Combining everything into an ensemble requires that they are all on a common grid
# This step is optional but if the models are not on a common grid, this will cause failure 
# when we come to the ensstats generation
rule _06_regrid:
    input:
        unpack(lambda wc: WORKFLOW['regrid']["input_dict"][os.path.join(outDirs['regridded'],wc.outfile)])
    output:
        os.path.join(outDirs['regridded'],"{outfile}")
    run:
        KAPy.regrid(outFile=output,
                    inFile=input,
                    tempDir=config['dirs']['tempDir'],
                    templateType=config["outputGrid"]["templateType"],
                    path=config["outputGrid"]["path"],
                    method=config['outputGrid']['method'])


# Enssemble Statistics 
# Now we can combine them into ensembles
rule _07_ensstats:
    input:
        unpack(lambda wc: WORKFLOW['ensstats']["input_dict"][os.path.join(outDirs['ensstats'],wc.es)])
    output:
        os.path.join(outDirs['ensstats'],"{es}")
    run:
        KAPy.generateEnsstats(outFile=output,
                              inFiles=input,
                              upperPercentile=config['ensembles']['upperPercentile'],
                              centralPercentile=config['ensembles']['centralPercentile'],
                              lowerPercentile=config['ensembles']['lowerPercentile'])

#Areal statistics
#Areal statistics are calculated for both the enssemble statistics and individual members
#Depending on whether we are using a shapefile or not, we may want to include the shapefile
#as a dependency
rule _08_arealstats:
    input:
        inputFile=lambda wildcards: WORKFLOW['arealstats']["input_dict"][os.path.join(outDirs['arealstats'],
                                                                                    wildcards.fname)],
        shapefile=lambda wildcards: config['arealstats']['shapefile'] if config['arealstats']['shapefile'] is not None else []
    output:
        os.path.join(outDirs['arealstats'],'{fname}')
    run:
        KAPy.generateArealstats(outFile=output,
                                inFile=input.inputFile,
                                tempDir=config['dirs']['tempDir'],
                                shapefile=config['arealstats']['shapefile'],
                                useAreaWeighting=config['arealstats']['useAreaWeighting'],
                                idColumn=config['arealstats']['idColumn'])

# #Plots        
