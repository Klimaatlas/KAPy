# KAPy Workflow
#
# This snakemake workflow handles the processing of data for use
# in Klimaatlas-like products. 
#
# The pipeline can be run using
#    > snakemake --cores 1 <target>
#
# A list of available target rules can be obatined using
#   > snakemake -S
#
# Workflow configuration options are set in config.yaml
#


#Setup-----------------------
#Configure logging
import logging
logging.getLogger("snakemake").setLevel(logging.WARNING)
logging.getLogger("snakemake").propagate = False  # stops messages bubbling up to root logger

#Load configuration 
import KAPy
import os
DEFAULT_CONFIG = "config/config.yaml"  #Defined relative to execution directory
if workflow.overwrite_configfiles:
    configfile_path = workflow.overwrite_configfiles[0]
else:
    configfile_path = DEFAULT_CONFIG
print(f'KAPy configuration file: {configfile_path}')
config=KAPy.get_config(configfile_path)

#Generate filename dicts
WORKFLOW=KAPy.get_workflow(config)

#Setup helpers
from pathlib import Path
OUTPUT_PATHS=KAPy.get_OUTPUT_PATHS(config["output_directory"]) 

# Wildcard rules -------------------------------------------
# Wildcard rules are generic rules in Snakemake that deal with many files at a time -
# in KAPy we preface all such rules with an underscore "_" and a number indicating
# where in the processing chain their lie.
# The wf dict describes the nodes that are linked in the pipeline that we are
# trying to create, ie file c.nc is generated from files a.nc and b.nc. Here we
# translate that mapping into snakemake by declaring the code required to make
# that transformation. There is generally one "wildcard rule" for each of the
# main processing steps

#Primary variables
#The rule is based on a dictionary mapping output files to input files, but we also 
#need to keep track of the corresponding inpID, which contains the various configurations
#relevant for that output file. 
for thisID, thisRow in WORKFLOW['primary_variables'].items():
    rule:
        name: f"..rule_01_primary_variable_{thisID}"
        input: unpack(lambda wc, rw=thisRow, pvID=thisID: rw["input_dict"][os.path.join(pvID,wc.file)])
        output: thisRow['output_rule']
        params: 
            row_arguments = config['inputs'][thisID],
            cutout_args   = config['cutouts']
        threads:
            KAPy.get_dask_threads(config['dask_resources'],"PRIMARY_VARIABLES",thisID)
        resources:
            **KAPy.get_dask_resources(config['dask_resources'],"PRIMARY_VARIABLES",thisID)
        script:
            "scripts/_01_primary_variables.py"        

# Secondary variables 
# "Secondary variables" are calculated as new variables derived from primary variables.  
# Good examples include FWI, PoteEvap and SPI. 
for thisID, thisRow in WORKFLOW['secondary_variables'].items():
    rule:
        name: f"..rule_02_secondary_variable_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw["input_dict"][wc.dataset +"_"+wc.leaf])
        output: **thisRow['output_rule']
        params: **config['secondary_variables'][thisID]
        threads:
            KAPy.get_dask_threads(config['dask_resources'],"SECONDARY_VARIABLES",thisID)
        resources:
            **KAPy.get_dask_resources(config['dask_resources'],"SECONDARY_VARIABLES",thisID)
        script:
            "scripts/_02_secondary_variables.py"

# Bias Adjustment 
for thisID, thisRow in WORKFLOW['bias_adjustment'].items():
    rule:
        name: f"..rule_03_bias_adjustment_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw['input_dict'][wc.leaf])
        output: **thisRow['output_rule']
        params: 
            **config['bias_adjustment'][thisID]
        threads:
            KAPy.get_dask_threads(config['dask_resources'],"BIAS_ADJUSTMENT",thisID)
        resources:
            **KAPy.get_dask_resources(config['dask_resources'],"BIAS_ADJUSTMENT",thisID)
        script:
            "scripts/_03_bias_adjustment.py"

# Tertiary variables 
# "Tertiary variables" are calculated as new variables derived from variables created
# by bias adjustment. Good examples include FWI, PoteEvap and SPI, but based on bias-adjusted
# variables, rather than raw input variables.
for thisID, thisRow in WORKFLOW['tertiary_variables'].items():
    rule:
        name: f"..rule_04_tertiary_variable_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw["input_dict"][wc.dataset +"_"+wc.leaf])
        output: **thisRow['output_rule']
        params: **config['tertiary_variables'][thisID]
        threads:
            KAPy.get_dask_threads(config['dask_resources'],"TERTIARY_VARIABLES",thisID)
        resources:
            **KAPy.get_dask_resources(config['dask_resources'],"TERTIARY_VARIABLES",thisID)
        script:
            "scripts/_04_tertiary_variables.py"

# Indicators 
# Create a loop over the indicators that defines the singular and plural rules
# as well as the combined run
for thisID, thisRow in WORKFLOW['indicators'].items():
    rule:
        name: f"..rule_05_indicator_{thisID}"
        input: unpack(lambda wc, rw=thisRow: rw["input_dict"][wc.dataset +"_"+wc.leaf])
        output: **thisRow['output_rule']
        params: 
            seasonsTable=config['seasons'],
            periodsTable=config['periods'],
            **config['indicators'][thisID]
        threads:
            KAPy.get_dask_threads(config['dask_resources'],"INDICATORS",thisID)
        resources:
            **KAPy.get_dask_resources(config['dask_resources'],"INDICATORS",thisID)
        script:
            "scripts/_05_indicators.py"        

# Regridding  
# Combining everything into an ensemble requires that they are all on a common grid
# This step is optional but if the models are not on a common grid, this will cause failure 
# when we come to the ensstats generation
do_regridding=config['output_grid']['template_type']!='none'
if do_regridding:
    rule:
        name: "..rule_06_regrid"
        input:
            unpack(lambda wc: WORKFLOW['regrid']["input_dict"][str(OUTPUT_PATHS['regrid'] / wc.outfile)])
        output:
            output=OUTPUT_PATHS['regrid'] /"{outfile}"
        params:
            templateType=config["output_grid"]["template_type"],
            path=config["output_grid"].get("path",""),
            method=config['output_grid'].get('method',"")
        threads:
            KAPy.get_dask_threads(config['dask_resources'],"REGRIDDING",thisID)
        resources:
            **KAPy.get_dask_resources(config['dask_resources'],"REGRIDDING",thisID)
        script:
            "scripts/_06_regrid.py"        

# Enssemble Statistics 
# Now we can combine them into ensembles
rule:
    name: "..rule_07_ensemble_statistics"
    input:
        unpack(lambda wc: WORKFLOW['ensemble_statistics']["input_dict"][str(OUTPUT_PATHS['ensemble_statistics'] /wc.es)])
    output:
        OUTPUT_PATHS['ensemble_statistics'] / "{es}"
    params:
        **config['ensembles']
    script:
        "scripts/_07_ensemble_statistics.py"        

#Areal statistics
#Areal statistics are calculated for both the enssemble statistics and individual members individually
#but can be turned on and off individually. However, the recipe for both types is fundamentally the
#same, so we take it as one rather than two rules
#Depending on whether we are using a shapefile or not, we may want to include the shapefile
#as a dependency
do_areal_statistics= config["areal_statistics"]["ensemble_areal_statistics"] or config["areal_statistics"]["member_areal_statistics"]
if do_areal_statistics:
    rule:
        name: "..rule_08_areal_statistics"
        input:
            inputFile=lambda wildcards: WORKFLOW['areal_statistics']["input_dict"][str(OUTPUT_PATHS['areal_statistics'] / wildcards.subdir /
                                                                                        wildcards.fname)],
            shapefile=lambda wildcards: config['areal_statistics']['shapefile'] if config['areal_statistics']['shapefile'] is not None else []
        output:
            OUTPUT_PATHS['areal_statistics'] /'{subdir}' / '{fname}'
        params:
            shapefile=config['areal_statistics']['shapefile'],
            useAreaWeighting=config['areal_statistics']['use_area_weighting']
        script:
            "scripts/_08_areal_statistics.py"
 
# # Individual targets -------------------------------
# # These are individual files that are produced, rather than a collection of files

#Make the variable overview
rule:
    name: ".OVERVIEW"
    run:
        KAPy.make_variable_overview(config)

#Merged csvs
#The merged_csvs dict is used to collate which arguments we have enabled.
merged_csvs={}
if config["areal_statistics"]["ensemble_areal_statistics"]:
    merged_csvs["ensemble_stats"]=OUTPUT_PATHS["ensemble_areal_statistics_csv"]
    rule:
        name: "..rule_09a_merged_ensemble_areal_statistics"
        input:
            WORKFLOW['merged_ensemble_areal_statistics']
        output:
            OUTPUT_PATHS["ensemble_areal_statistics_csv"]
        run:
            KAPy.merge_csvs(input_files=input,output_file=output[0])

if config["areal_statistics"]["member_areal_statistics"]:
    merged_csvs["ensemble_members"]=OUTPUT_PATHS["member_areal_statistics_csv"]
    rule:
        name:  "..rule_09b_merged_member_areal_statistics"
        input:
            WORKFLOW['merged_member_areal_statistics']
        output:
            OUTPUT_PATHS["member_areal_statistics_csv"]
        run:
            KAPy.merge_csvs(input_files=input,output_file=output[0])

# Database 
rule:
    name: ".DATABASE"
    input:
        **merged_csvs,
        indicators=config['configuration_tables']['indicators'],
        periods=config['configuration_tables']['periods'],
        seasons=config['configuration_tables']['seasons'],
        config_file=configfile_path
    output:
        database=OUTPUT_PATHS["database"]
    params:
    run:
        db = KAPy.database(input.config_file,tempDir=resources.tmpdir)
        db.create_full_database()
        db.close()
            

# Helper Targets ---------------------------------------------------------
# Here we define a series of short-hand targets that can be used to run 
# subsets of the full graph i.e. to make sets of files. This is not strictly
# necessary, but is a nice help for the user.

#Primary variables
rule:
    name: ".PRIMARY_VARIABLES"
    input:
        [t for v in WORKFLOW['primary_variables'].values() for t in v['outputs']]

#Secondary variables  
if "secondary_variables" in config:
    rule:
        name: ".SECONDARY_VARIABLES"
        input:
            [t for v in WORKFLOW['secondary_variables'].values() for t in v['outputs']]

#Bias adjustment
if "bias_adjustment" in config:
    rule:
        name: ".BIAS_ADJUSTMENT"
        input:
            [f for v in WORKFLOW['bias_adjustment'].values() for f in v['outputs'] ]

#Tertiary variables
if "tertiary_variables" in config:
    rule:
        name: ".TERTIARY_VARIABLES"
        input:
            [f for v in WORKFLOW['tertiary_variables'].values() for f in v['outputs']]

#Indicator variables
rule:
    name: ".INDICATORS"
    input:
        [f for v in WORKFLOW['indicators'].values() for f in v["outputs"]]

#Regridding
if do_regridding:
    rule:
        name: ".REGRID"
        input:
            WORKFLOW['regrid']['outputs']

#Ensemble statistics
rule:
    name: ".ENSEMBLE_STATISTICS"
    input:
        WORKFLOW['ensemble_statistics']['outputs']


#Areal statistics
# (but only if they are requested)
if do_areal_statistics:
    rule:
        name: ".AREAL_STATISTICS"
        input:
            WORKFLOW['areal_statistics']['outputs']

    rule:
        name: ".MERGED_AREAL_STATISTICS"
        input:
            **merged_csvs


#All
rule:
    name: ".ALL"
    input:
        WORKFLOW['all']
    default_target: True

#And finally, one target for each configuration group.
for wf_key in WORKFLOW.keys():
    if wf_key in ['primary_variables','secondary_variables',"bias_adjustment",'tertiary_variables','indicators']:
        for item_key in WORKFLOW[wf_key].keys():
            rule:
                name: f"{item_key}"
                input: WORKFLOW[wf_key][item_key]["outputs"]
                    
