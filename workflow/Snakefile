# # Individual targets -------------------------------
# # These are individual files that are produced, rather than a collection of files

#Make the variable overview
rule overview:
    run:
        KAPy.VariableOverview(config)

#Merged csvs
rule areal_ensstats:
    input:
        WORKFLOW['mergedCSVs']['ensstats']
    output:
        os.path.join(outDirs['outputs'],config['outputs']["ensembleStatisticsCSV"])
    run:
        KAPy.mergeCSVs(outFile=output,inFiles=input)

rule areal_members:
    input:
        WORKFLOW['mergedCSVs']['members']
    output:
        os.path.join(outDirs['outputs'],config['outputs']["ensembleMembersCSV"])
    run:
        KAPy.mergeCSVs(outFile=output,inFiles=input)

# Database 
rule database:
    input:
        ensstats=rules.areal_ensstats.output,
        members=rules.areal_members.output
    output:
        os.path.join(outDirs['outputs'],config['outputs']["database"])
    run:
        KAPy.writeToDatabase(outFile=output,
                             ensstats=input.ensstats, 
                             members=input.members)

# Helper Targets ---------------------------------------------------------
# Here we define a series of short-hand targets that can be used to run 
# subsets of the full graph i.e. to make sets of files. This is not strictly
# necessary, but is a nice help for the user.

#Primary variables
rule primaryVars:
    input:
        [v["outputs"] for v in WORKFLOW['primary_vars'].values()]
#Secondary variables  
rule secondaryVars:
    input:
        [t for v in WORKFLOW['secondary_vars'].values() for t in v['outputs']]

#Bias adjustment
rule biasAdjustment:
    input:
        [v['outputs'] for v in WORKFLOW['bias_adj'].values() ]

#Tertiary variables
rule tertiaryVars:
    input:
        [t for v in WORKFLOW['tertiary_vars'].values() for t in v['outputs']]

#Indicator variables
rule indicators:
    input:
        [k for thisInd in WORKFLOW['indicators'].values() for k in thisInd["outputs"]]

#Regridding
if config['outputGrid']['templateType']!='none':
    rule regrid:
        input:
            WORKFLOW['regrid']['outputs']

#Ensemble statistics
rule ensstats:
    input:
        WORKFLOW['ensstats']['outputs']


#Ensemble statistics
rule arealstats:
    input:
        WORKFLOW['arealstats']['outputs']

# #Plots
# rule plots:
#     input:
#         list(wf['plots'].keys())

#All
rule all:
    input:
        WORKFLOW['all'],
        rules.areal_members.output,
        rules.areal_ensstats.output,
        rules.database.output
    default_target: True
