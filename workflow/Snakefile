#     input:
#         lambda wildcards: wf['plots'][os.path.join(outDirs['outputs'],'plots',
#                                                    f"{wildcards.indID}_spatial.png")]
#     run:
#         KAPy.makeSpatialplot(outFile=output,
#                              srcFiles=input)
        

# # Individual targets -------------------------------
# # These are individual files that are produced, rather than a collection of files

#Make the variable overview
rule OVERVIEW:
    run:
        KAPy.VariableOverview(config)

#Merged csvs
rule _09_areal_ensstats:
    input:
        WORKFLOW['mergedCSVs']['ensstats']
    output:
        os.path.join(outDirs['outputs'],config['outputs']["ensembleStatisticsCSV"])
    run:
        KAPy.mergeCSVs(outFile=output,inFiles=input)

rule _09_areal_members:
    input:
        WORKFLOW['mergedCSVs']['members']
    output:
        os.path.join(outDirs['outputs'],config['outputs']["ensembleMembersCSV"])
    run:
        KAPy.mergeCSVs(outFile=output,inFiles=input)

# Database 
rule _09_database:
    input:
        ensstats=rules._09_areal_ensstats.output,
        members=rules._09_areal_members.output
    output:
        os.path.join(outDirs['outputs'],config['outputs']["database"])
    run:
        KAPy.writeToDatabase(outFile=output,
                             ensstats=input.ensstats, 
                             members=input.members)

# Helper Targets ---------------------------------------------------------
# Here we define a series of short-hand targets that can be used to run 
# subsets of the full graph i.e. to make sets of files. This is not strictly
# necessary, but is a nice help for the user.

#Primary variables
rule PRIMARY_VARIABLES:
    input:
        [v["outputs"] for v in WORKFLOW['primary_vars'].values()]

#Secondary variables  
if "secondaryVars" in config:
    rule SECONDARY_VARIABLES:
        input:
            [t for v in WORKFLOW['secondary_vars'].values() for t in v['outputs']]

#Bias adjustment
if "biasAdjustment" in config:
    rule BIAS_ADJUSTMENT:
        input:
            [v['outputs'] for v in WORKFLOW['bias_adj'].values() ]

#Tertiary variables
if "tertiaryVars" in config:
    rule TERTIARY_VARIABLES:
        input:
            [t for v in WORKFLOW['tertiary_vars'].values() for t in v['outputs']]

#Indicator variables
rule INDICATORS:
    input:
        [k for thisInd in WORKFLOW['indicators'].values() for k in thisInd["outputs"]]

#Regridding
if config['outputGrid']['templateType']!='none':
    rule REGRIDDING:
        input:
            WORKFLOW['regrid']['outputs']

#Ensemble statistics
rule ENSEMBLE_STATISTICS:
    input:
        WORKFLOW['ensstats']['outputs']


#Ensemble statistics
rule AREAL_STATISTICS:
    input:
        WORKFLOW['arealstats']['outputs']

# #Plots
# rule plots:
#     input:
#         list(wf['plots'].keys())

rule OUTPUTS:
    input:
        rules._09_areal_ensstats.output,
        rules._09_areal_ensstats.output,
        rules._09_database.output

#All
rule ALL:
    input:
        WORKFLOW['all'],
        rules.OUTPUTS.input
    default_target: True


#And finally, one target for each configuration group.
for wf_key in WORKFLOW.keys():
    if wf_key in ['secondary_vars',"bias_adj",'tertiary_vars','indicators']:
        for item_key in WORKFLOW[wf_key].keys():
            rule:
                name: f".{item_key}"
                input: WORKFLOW[wf_key][item_key]["outputs"]
                    
#Primary variables are a bit trickey, and require processing the entire dict first
primary_var_output_groups={out['groupID'] : [] for out in WORKFLOW['primary_vars'].values()}
for out in WORKFLOW['primary_vars'].values():
    primary_var_output_groups[out['groupID']] += [out['outputs']]
for item_key,outputs in primary_var_output_groups.items():
    rule:
        name: f".{item_key}"
        input: outputs

